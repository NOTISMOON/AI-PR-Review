# ── 数据库 ──
#db
DATABASE_URL=

# ── 认证 / OAuth ──
# JWT 签名密钥（务必改成随机字符串并保密）
AUTH_JWT_SECRET=

# GitHub App / OAuth App 凭证
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# GitHub App（机器人身份：自动审查决策回写）
# 在 GitHub App 设置里下载私钥，填文件路径或内联 PEM 二选一
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY_PATH=
# GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"

# Gitee 第三方应用凭证
GITEE_CLIENT_ID=
GITEE_CLIENT_SECRET=

# ── Redis（refresh_token 存储；未配置时降级为进程内存）──
# REDIS_URL=redis://localhost:6379

# ── PR Review 业务库（MySQL，登录落库 prreview_db.user）──
# PR_MYSQL_URL=mysql://root:pass@127.0.0.1:3306/prreview_db